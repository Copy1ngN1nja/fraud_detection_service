# Скопируйте этот файл в .env (cp .env.example .env) и при необходимости
# поменяйте значения. Значения по умолчанию ниже подходят для локального
# запуска "из коробки" через docker-compose.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fraud_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SCORING_TOPIC=scoring

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Опционально: API-токен Grafana (Configuration -> API keys / Service accounts),
# нужен только для того, чтобы fraud_detector мог пушить аннотации о раундах
# adversarial-валидации на дашборд. Без него всё остальное (сами дашборды,
# графики) работает как обычно - они читают данные напрямую из Postgres/Prometheus.
GRAFANA_API_KEY=
